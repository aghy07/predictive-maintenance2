APP_ENV=development
DATABASE_URL=sqlite:///./predictive.db
# For Vercel production, use Supabase Connect -> Shared Pooler -> Transaction (port 6543).
# The app accepts postgresql:// or postgresql+psycopg:// and normalizes in production.
# Keep the provider-issued pooler host, username, and password; never commit its URL.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MODEL_PATH=ml/model.joblib
METADATA_PATH=ml/model_metadata.json
FRONTEND_URL=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
BOOTSTRAP_ADMIN_NAME=Administrator
